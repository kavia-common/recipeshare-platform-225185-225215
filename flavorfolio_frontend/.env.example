# FlavorFolio Frontend (.env.example)
# Copy this file to ".env" and adjust values as needed.

# Backend and Frontend URLs
# Backend defaults to local Express server
REACT_APP_BACKEND_URL=http://localhost:3001
# Frontend URL used for redirects and CORS allowlist
REACT_APP_FRONTEND_URL=http://localhost:3000

# Site URL for Supabase email redirect (signup confirmation)
# Typically the same as REACT_APP_FRONTEND_URL
REACT_APP_SITE_URL=http://localhost:3000

# Supabase configuration (required for real auth)
# Create a project at https://supabase.com/ and paste your values below.
# Never use the service role key here; only the anon public key.
REACT_APP_SUPABASE_URL=your-supabase-url
REACT_APP_SUPABASE_KEY=your-supabase-anon-key
