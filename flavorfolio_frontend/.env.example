# Frontend environment variables for FlavorFolio (React CRA)

# Backend API base (prefer HTTPS in production)
REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend site URL (used for Supabase email redirect after sign up)
REACT_APP_FRONTEND_URL=http://localhost:3000
# Optional alias used in SignIn for redirect config
REACT_APP_SITE_URL=http://localhost:3000

# Supabase project configuration (Anon key only; never commit service role key)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_KEY=

# Optional environment hints
REACT_APP_NODE_ENV=development
REACT_APP_LOG_LEVEL=info
